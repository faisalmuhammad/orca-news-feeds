{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "preserveSymlinks": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "typeRoots": ["./build/node_modules/@types"],
    "allowImportingTsExtensions": true
  },
  "include": ["build/src", "build/types/**/*.d.ts"]
}
